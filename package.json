  "scripts": {
    "start": "cross-env HOST=0.0.0.0 PORT=3000 react-scripts start",
    "start:3000": "PORT=3000 react-scripts start",
    "start:5173": "VITE_PORT=5173 react-scripts start",
    "build": "react-scripts build",
    "build:android": "cross-env REACT_APP_ANDROID_BUILD=true npm run build && npx cap sync android",
    "android:live": "cross-env ANDROID_LIVE_RELOAD=wireless CAPACITOR_LIVE_RELOAD_HOST=192.168.100.5 node scripts/android-live-reload.js",
    "android:live:wifi": "cross-env ANDROID_LIVE_RELOAD=wireless CAPACITOR_LIVE_RELOAD_HOST=192.168.100.5 node scripts/android-live-reload.js",
    "android:live:usb": "node scripts/android-live-reload.js",
    "android:debug-live": "powershell -ExecutionPolicy Bypass -File scripts\\auto-debug-live.ps1",
    "android:debug-live:auto": "powershell -ExecutionPolicy Bypass -File scripts\\auto-debug-live.ps1",
    "android:release": "cross-env REACT_APP_ANDROID_BUILD=true npm run build && npx cap sync android && node scripts/build-android-release.js",
    "android:open": "npx cap open android",
    "android:run": "npm run build:android && npx cap run android",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
